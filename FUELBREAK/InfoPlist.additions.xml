<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">

<!--
  ══════════════════════════════════════════════════════════════════
  INFO.PLIST ADDITIONS — Sensaro iOS App
  ══════════════════════════════════════════════════════════════════

  Paste these keys inside the root <dict> of your Info.plist.
  NSLocationAlwaysAndWhenInUseUsageDescription is now REQUIRED
  because the app requests Always authorization when the user
  enables "Background Fire Alerts".
  ══════════════════════════════════════════════════════════════════
-->

<plist version="1.0">
<dict>

    <!-- ── Camera ─────────────────────────────────────────────── -->
    <key>NSCameraUsageDescription</key>
    <string>Sensaro uses the camera to take and upload photos of forestry concerns (e.g., diseased trees, invasive species) or wildfire risks (e.g., dry brush). For example, photograph a high-risk area and upload it to notify local forestry services.</string>

    <!-- ── Photo Library ──────────────────────────────────────── -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Sensaro needs photo library access to upload existing photos of forestry concerns.</string>

    <!-- ── Location (foreground) ──────────────────────────────── -->
    <!--
        Shown for standard map and fire-danger lookups while the
        app is open.
    -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Sensaro uses your location to show real-time wildfire danger near you and to accurately pin forestry concern reports on the map.</string>

    <!-- ── Location (background / Always) ────────────────────── -->
    <!--
        Only requested when the user explicitly enables
        "Background Fire Alerts" in the app.
        Required for:
          • Continuous location streaming to the live wildfire map
          • Geofence monitoring that sends alerts when the user
            enters or exits a fire danger zone, even when the
            app is closed.
    -->
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Allow Sensaro to monitor your location in the background so you receive alerts when you enter a wildfire danger zone, even when the app is closed. This is only used when you enable Background Fire Alerts.</string>

</dict>
</plist>
