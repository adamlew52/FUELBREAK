import SwiftUI
import StoreKit

// ═══════════════════════════════════════════════════════════════════════════
//  PaywallView.swift  —  TIER EDITION
//
//  ⚠️ ONE MANUAL STEP BEFORE THIS COMPILES
//  Your existing PaywallView.swift also declared `private struct EULASheetView`.
//  That struct is NOT reproduced here. Cut it out of your old file, paste it
//  into a new file `EULASheetView.swift`, and change `private struct` to
//  `struct` so this file can still reach it. Nothing else about it changes —
//  except that EULA §3 now describes credit packs, so its wording should be
//  updated to describe tiers (see README-TIERS.md, "Legal copy").
// ═══════════════════════════════════════════════════════════════════════════

struct PaywallView: View {

    @StateObject private var store = StoreKitManager()

    let idToken: String

    /// Fires with the tier the user ended up on, so the host view can refresh
    /// its own gating without re-fetching.
    var onTierChanged: ((SensaroTier) -> Void)? = nil

    /// When the paywall is opened *because* a locked feature was tapped, pass
    /// it in — the header then explains what's actually being unlocked instead
    /// of showing generic upsell copy.
    var lockedFeature: SensaroFeature? = nil

    @Environment(\.dismiss) private var dismiss

    @State private var period: BillingPeriod = .yearly
    @State private var showSuccessAlert = false
    @State private var showErrorAlert   = false
    @State private var alertMessage     = ""
    @State private var successMessage   = ""
    @State private var showEULA         = false

    private let bg      = Color(red: 0.04, green: 0.12, blue: 0.04)
    private let ember   = Color(red: 0.96, green: 0.61, blue: 0.04)

    var body: some View {
        ZStack {
            bg.ignoresSafeArea()
            RadialGradient(
                colors: [Color(red: 0.19, green: 0.44, blue: 0.19).opacity(0.35), Color.clear],
                center: .top, startRadius: 0, endRadius: 400
            ).ignoresSafeArea()

            ScrollView {
                VStack(spacing: 0) {
                    headerSection
                    if !store.hasLifetime { periodToggle }
                    tierCards
                    if !store.hasLifetime && store.entitledTier != .gold { lifetimeSection }
                    enterpriseSection
                    footerButtons
                }
                .padding(.bottom, 40)
            }
        }
        .overlay(purchaseOverlay)
        .alert("You're all set", isPresented: $showSuccessAlert) {
            Button("Done") { dismiss() }
        } message: { Text(successMessage) }
        .alert("That didn't go through", isPresented: $showErrorAlert) {
            Button("OK") { }
        } message: { Text(alertMessage) }
        .onChange(of: store.purchaseState) { state in handlePurchaseState(state) }
        .onChange(of: store.entitledTier) { tier in onTierChanged?(tier) }
        .task { await store.syncServerTier(idToken: idToken) }
        .sheet(isPresented: $showEULA) { EULASheetView() }
    }


    // MARK: - Header

    private var headerSection: some View {
        VStack(spacing: 12) {
            HStack {
                Spacer()
                Button(action: { dismiss() }) {
                    Image(systemName: "xmark.circle.fill")
                        .font(.title2).foregroundColor(.white.opacity(0.5))
                }
                .padding(.trailing, 20).padding(.top, 16)
                .accessibilityLabel("Close")
            }

            ZStack {
                Circle()
                    .fill(LinearGradient(
                        colors: [ember, Color(red: 0.85, green: 0.40, blue: 0.02)],
                        startPoint: .topLeading, endPoint: .bottomTrailing))
                    .frame(width: 72, height: 72)
                Image(systemName: lockedFeature == nil ? "flame.fill" : "lock.open.fill")
                    .font(.system(size: 32)).foregroundColor(.white)
            }
            .shadow(color: ember.opacity(0.5), radius: 20)

            Text(lockedFeature == nil ? "Sensaro Plans" : "Unlock \(lockedFeature!.title)")
                .font(.system(size: 27, weight: .bold, design: .rounded))
                .foregroundColor(.white)
                .multilineTextAlignment(.center)
                .padding(.horizontal, 24)

            Text(headerSubtitle)
                .font(.system(size: 15)).foregroundColor(.white.opacity(0.6))
                .multilineTextAlignment(.center).padding(.horizontal, 36)

            if store.entitledTier != .free {
                HStack(spacing: 6) {
                    Circle().fill(store.entitledTier.accent).frame(width: 7, height: 7)
                    Text(store.hasLifetime
                         ? "Gold · lifetime"
                         : "Currently on \(store.entitledTier.displayName)")
                        .font(.system(size: 12, weight: .semibold))
                        .foregroundColor(.white.opacity(0.75))
                }
                .padding(.horizontal, 12).padding(.vertical, 6)
                .background(Capsule().fill(Color.white.opacity(0.07)))
                .padding(.top, 2)
            }
        }
        .padding(.bottom, 22)
    }

    private var headerSubtitle: String {
        if let feature = lockedFeature {
            return "Included with \(feature.minimumTier.displayName) and above."
        }
        return "Pick the level that matches how you use the land."
    }


    // MARK: - Period Toggle

    private var periodToggle: some View {
        HStack(spacing: 0) {
            toggleButton(.monthly, label: "Monthly")
            toggleButton(.yearly,  label: "Yearly")
        }
        .padding(4)
        .background(Capsule().fill(Color.white.opacity(0.07)))
        .overlay(Capsule().stroke(Color.white.opacity(0.1), lineWidth: 1))
        .padding(.bottom, 18)
        .accessibilityElement(children: .contain)
    }

    private func toggleButton(_ value: BillingPeriod, label: String) -> some View {
        let selected = period == value
        return Button {
            withAnimation(.easeOut(duration: 0.18)) { period = value }
        } label: {
            HStack(spacing: 6) {
                Text(label)
                    .font(.system(size: 13, weight: .semibold))
                if value == .yearly {
                    Text("SAVE 17%")
                        .font(.system(size: 9, weight: .bold))
                        .padding(.horizontal, 6).padding(.vertical, 2)
                        .background(Capsule().fill(selected ? Color.black.opacity(0.18) : ember.opacity(0.25)))
                        .foregroundColor(selected ? .black.opacity(0.7) : ember)
                }
            }
            .foregroundColor(selected ? .black : .white.opacity(0.6))
            .padding(.horizontal, 20).padding(.vertical, 9)
            .background(Capsule().fill(selected ? Color.white.opacity(0.92) : Color.clear))
        }
        .buttonStyle(.plain)
    }


    // MARK: - Tier Cards

    private var tierCards: some View {
        VStack(spacing: 12) {
            ForEach([SensaroTier.bronze, .silver, .gold], id: \.self) { tier in
                if let sku = SensaroProduct.forTier(tier, period: period) {
                    TierCard(
                        tier: tier,
                        price: store.formattedPrice(for: sku),
                        periodSuffix: period.suffix,
                        monthlyEquivalent: store.monthlyEquivalent(for: sku),
                        features: SensaroFeature.unlocked(at: tier).map(\.title),
                        inheritsFrom: inheritedLabel(for: tier),
                        isCurrent: store.isCurrentPlan(sku),
                        isIncluded: store.entitledTier > tier,
                        isRecommended: recommendedTier == tier,
                        isLoading: store.isLoadingProducts
                    ) {
                        Task { await store.purchase(sku, idToken: idToken) }
                    }
                }
            }
        }
        .padding(.horizontal, 20)
        .padding(.bottom, 16)
    }

    /// Highlight the tier that actually solves the user's problem: the one the
    /// locked feature needs, or Silver as the general-purpose middle.
    private var recommendedTier: SensaroTier {
        lockedFeature?.minimumTier ?? .silver
    }

    private func inheritedLabel(for tier: SensaroTier) -> String? {
        switch tier {
        case .silver: return "Everything in Bronze, plus"
        case .gold:   return "Everything in Silver, plus"
        default:      return nil
        }
    }


    // MARK: - Lifetime

    private var lifetimeSection: some View {
        VStack(alignment: .leading, spacing: 12) {
            SectionLabel(text: "ONE-TIME PURCHASE")
            LifetimeCard(
                price: store.formattedPrice(for: .goldLifetime),
                isLoading: store.isLoadingProducts
            ) {
                Task { await store.purchase(.goldLifetime, idToken: idToken) }
            }
            .padding(.horizontal, 20)
        }
        .padding(.bottom, 18)
    }


    // MARK: - Enterprise

    private var enterpriseSection: some View {
        VStack(alignment: .leading, spacing: 12) {
            SectionLabel(text: "ENTERPRISE")
            Button(action: openEnterprise) {
                HStack {
                    VStack(alignment: .leading, spacing: 4) {
                        Text("Custom / Unlimited")
                            .font(.system(size: 16, weight: .semibold)).foregroundColor(.white)
                        Text("Fire departments, foresters, private companies")
                            .font(.system(size: 13)).foregroundColor(.white.opacity(0.55))
                    }
                    Spacer()
                    Image(systemName: "envelope.fill").foregroundColor(ember)
                }
                .padding(18)
                .background(RoundedRectangle(cornerRadius: 14).fill(Color.white.opacity(0.05))
                    .overlay(RoundedRectangle(cornerRadius: 14).stroke(Color.white.opacity(0.1), lineWidth: 1)))
            }
            .buttonStyle(.plain)
            .padding(.horizontal, 20)
        }
        .padding(.bottom, 26)
    }


    // MARK: - Footer

    private var footerButtons: some View {
        VStack(spacing: 14) {
            Button(action: { Task { await store.restorePurchases(idToken: idToken) } }) {
                Text("Restore purchases")
                    .font(.system(size: 14, weight: .medium)).foregroundColor(.white.opacity(0.5))
            }

            if store.entitledTier != .free && !store.hasLifetime {
                Button(action: openManageSubscriptions) {
                    Text("Manage subscription")
                        .font(.system(size: 14, weight: .medium)).foregroundColor(.white.opacity(0.5))
                }
            }

            HStack(spacing: 6) {
                Button(action: openPrivacyPolicy) {
                    Text("Privacy Policy")
                        .font(.system(size: 12, weight: .medium))
                        .foregroundColor(.white.opacity(0.4)).underline()
                }
                Text("·").font(.system(size: 12)).foregroundColor(.white.opacity(0.25))
                Button(action: { showEULA = true }) {
                    Text("Terms of Use")
                        .font(.system(size: 12, weight: .medium))
                        .foregroundColor(.white.opacity(0.4)).underline()
                }
            }

            Text("Subscriptions renew automatically until cancelled. Cancel anytime in Settings → Apple ID → Subscriptions. The lifetime purchase never renews.")
                .font(.system(size: 11)).foregroundColor(.white.opacity(0.3))
                .multilineTextAlignment(.center).padding(.horizontal, 30)
        }
    }


    // MARK: - Overlay

    @ViewBuilder
    private var purchaseOverlay: some View {
        if store.purchaseState == .purchasing {
            ZStack {
                Color.black.opacity(0.6).ignoresSafeArea()
                VStack(spacing: 16) {
                    ProgressView().scaleEffect(1.4).tint(.white)
                    Text("Processing…").font(.system(size: 15, weight: .medium)).foregroundColor(.white)
                }
                .padding(32)
                .background(RoundedRectangle(cornerRadius: 18).fill(Color(red: 0.1, green: 0.1, blue: 0.1)))
            }
        }
    }


    // MARK: - Actions

    private func openEnterprise() {
        if let url = URL(string: "mailto:contact@sensaro.net?subject=Enterprise%20Inquiry") {
            UIApplication.shared.open(url)
        }
    }

    private func openPrivacyPolicy() {
        if let url = URL(string: "https://www.sensaro.net/Mobile/Privacy-Policy/FUELBREAK-Twin_Timbers.html") {
            UIApplication.shared.open(url)
        }
    }

    private func openManageSubscriptions() {
        guard let scene = UIApplication.shared.connectedScenes.first as? UIWindowScene else { return }
        Task { await store.showManageSubscriptions(in: scene) }
    }

    private func handlePurchaseState(_ state: PurchaseState) {
        switch state {
        case .success(_, let tier):
            onTierChanged?(tier)
            successMessage = tier == .gold && store.hasLifetime
                ? "Gold is yours for good. Every feature is unlocked."
                : "\(tier.displayName) is active. \(tier.blurb)"
            showSuccessAlert = true

        case .pending:
            alertMessage = "This purchase needs approval before it completes. You'll get access as soon as it's approved."
            showErrorAlert = true

        case .failed(let msg):
            alertMessage = msg
            showErrorAlert = true

        default:
            break
        }
    }
}


// MARK: - Tier Card

private struct TierCard: View {
    let tier: SensaroTier
    let price: String
    let periodSuffix: String
    let monthlyEquivalent: String?
    let features: [String]
    let inheritsFrom: String?
    let isCurrent: Bool
    let isIncluded: Bool        // user is on a higher tier already
    let isRecommended: Bool
    let isLoading: Bool
    let onTap: () -> Void

    var body: some View {
        VStack(alignment: .leading, spacing: 0) {

            HStack(alignment: .firstTextBaseline) {
                HStack(spacing: 8) {
                    Circle().fill(tier.accent).frame(width: 9, height: 9)
                    Text(tier.displayName.uppercased())
                        .font(.system(size: 15, weight: .bold, design: .rounded))
                        .tracking(1.2)
                        .foregroundColor(.white)
                }
                Spacer()
                if isRecommended && !isCurrent && !isIncluded {
                    Text("RECOMMENDED")
                        .font(.system(size: 9, weight: .bold)).tracking(0.8)
                        .foregroundColor(.black)
                        .padding(.horizontal, 8).padding(.vertical, 3)
                        .background(Capsule().fill(tier.accent))
                }
            }
            .padding(.bottom, 6)

            Text(tier.blurb)
                .font(.system(size: 12.5)).foregroundColor(.white.opacity(0.55))
                .fixedSize(horizontal: false, vertical: true)
                .padding(.bottom, 12)

            if isLoading {
                ProgressView().tint(.white).padding(.vertical, 6)
            } else {
                HStack(alignment: .firstTextBaseline, spacing: 5) {
                    Text(price)
                        .font(.system(size: 26, weight: .bold, design: .rounded))
                        .foregroundColor(tier.accent)
                    Text(periodSuffix)
                        .font(.system(size: 12)).foregroundColor(.white.opacity(0.45))
                }
                if let monthlyEquivalent {
                    Text("\(monthlyEquivalent) / month, billed yearly")
                        .font(.system(size: 11)).foregroundColor(.white.opacity(0.35))
                        .padding(.top, 1)
                }
            }

            if let inheritsFrom {
                Text(inheritsFrom.uppercased())
                    .font(.system(size: 9.5, weight: .bold)).tracking(0.9)
                    .foregroundColor(.white.opacity(0.3))
                    .padding(.top, 14)
            }

            VStack(alignment: .leading, spacing: 7) {
                ForEach(features, id: \.self) { feature in
                    HStack(alignment: .top, spacing: 8) {
                        Image(systemName: "checkmark")
                            .font(.system(size: 10, weight: .bold))
                            .foregroundColor(tier.accent)
                            .padding(.top, 2)
                        Text(feature)
                            .font(.system(size: 13)).foregroundColor(.white.opacity(0.8))
                            .fixedSize(horizontal: false, vertical: true)
                    }
                }
            }
            .padding(.top, inheritsFrom == nil ? 14 : 8)

            Button(action: onTap) {
                Text(buttonLabel)
                    .font(.system(size: 14, weight: .bold))
                    .foregroundColor(isActionable ? .black : .white.opacity(0.55))
                    .frame(maxWidth: .infinity).padding(.vertical, 11)
                    .background(RoundedRectangle(cornerRadius: 10)
                        .fill(isActionable ? tier.accent : Color.white.opacity(0.12)))
            }
            .buttonStyle(.plain)
            .disabled(!isActionable || isLoading)
            .padding(.top, 16)
        }
        .padding(18)
        .background(
            RoundedRectangle(cornerRadius: 16).fill(Color.white.opacity(0.06))
                .overlay(RoundedRectangle(cornerRadius: 16)
                    .stroke(isRecommended && isActionable ? tier.accent.opacity(0.55) : Color.white.opacity(0.1),
                            lineWidth: isRecommended && isActionable ? 1.5 : 1))
        )
        .opacity(isIncluded ? 0.55 : 1)
    }

    private var isActionable: Bool { !isCurrent && !isIncluded }

    private var buttonLabel: String {
        if isCurrent  { return "Current plan" }
        if isIncluded { return "Included in your plan" }
        return "Choose \(tier.displayName)"
    }
}


// MARK: - Lifetime Card

private struct LifetimeCard: View {
    let price: String
    let isLoading: Bool
    let onTap: () -> Void

    private let gold = Color(red: 0.90, green: 0.66, blue: 0.17)

    var body: some View {
        Button(action: onTap) {
            HStack(spacing: 16) {
                ZStack {
                    RoundedRectangle(cornerRadius: 12).fill(gold.opacity(0.15))
                        .frame(width: 52, height: 52)
                    Image(systemName: "infinity").font(.system(size: 22, weight: .semibold))
                        .foregroundColor(gold)
                }
                VStack(alignment: .leading, spacing: 3) {
                    Text("Gold, for good")
                        .font(.system(size: 17, weight: .bold, design: .rounded))
                        .foregroundColor(.white)
                    Text("Pay once. Every feature, no renewals.")
                        .font(.system(size: 12)).foregroundColor(.white.opacity(0.55))
                }
                Spacer()
                if isLoading {
                    ProgressView().tint(.white)
                } else {
                    VStack(spacing: 3) {
                        Text(price).font(.system(size: 19, weight: .bold, design: .rounded))
                            .foregroundColor(.white)
                        Text("Buy").font(.system(size: 12, weight: .semibold)).foregroundColor(.black)
                            .padding(.horizontal, 14).padding(.vertical, 5)
                            .background(Capsule().fill(gold))
                    }
                }
            }
            .padding(16)
            .background(RoundedRectangle(cornerRadius: 16).fill(Color.white.opacity(0.06))
                .overlay(RoundedRectangle(cornerRadius: 16).stroke(gold.opacity(0.4), lineWidth: 1.5)))
        }
        .buttonStyle(.plain).disabled(isLoading)
    }
}


// MARK: - Section Label

private struct SectionLabel: View {
    let text: String
    var body: some View {
        Text(text).font(.system(size: 11, weight: .bold)).foregroundColor(.white.opacity(0.35))
            .tracking(1.5).padding(.horizontal, 20)
            .frame(maxWidth: .infinity, alignment: .leading)
    }
}


