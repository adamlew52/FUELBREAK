import Foundation
import StoreKit

// ═══════════════════════════════════════════════════════════════════════════
//  StoreKitManager.swift  —  TIER EDITION
//
//  WHAT CHANGED FROM THE CREDIT VERSION
//  ------------------------------------
//  • `credits` / `creditsAdded` are gone from the purchase path. A purchase
//    now results in a TIER, and the tier decides what opens.
//  • Entitlement is resolved by scanning `Transaction.currentEntitlements` for
//    the HIGHEST tier the user holds. StoreKit's entitlements are signed by
//    Apple and verified on-device, so this is a legitimate offline source of
//    truth — not a guess.
//  • The old code granted credits locally whenever the Lambda call failed OR
//    whenever `idToken` was empty. That second branch was an unauthenticated
//    grant path. It's replaced here: a failed *server sync* no longer blocks
//    the user (the signed StoreKit entitlement already proves the purchase),
//    but nothing is granted without a verified transaction behind it.
//  • Server sync is now one-directional and explicit: we tell the backend what
//    Apple told us, the backend writes Cognito `custom:tier`, and the web
//    dashboard reads that. The backend stays authoritative.
// ═══════════════════════════════════════════════════════════════════════════


// MARK: - Purchase State

enum PurchaseState: Equatable {
    case idle
    case purchasing
    case success(productID: String, tier: SensaroTier)
    case failed(String)
    case cancelled
    case pending          // Ask-to-Buy / SCA — resolves via the transaction listener
}


// MARK: - StoreKitManager

@MainActor
final class StoreKitManager: ObservableObject {

    // ── Published state ──────────────────────────────────────────────────
    @Published var products: [Product] = []
    @Published var purchaseState: PurchaseState = .idle
    @Published var isLoadingProducts = true

    /// The tier the user may actually use right now. This is the value every
    /// gate in the app should read.
    @Published private(set) var entitledTier: SensaroTier = .free

    /// Tier proven by StoreKit's own signed entitlements on this device.
    @Published private(set) var localTier: SensaroTier = .free

    /// Tier reported by the backend (`custom:tier`). Covers Stripe web
    /// purchases and purchases made on another platform.
    @Published private(set) var serverTier: SensaroTier = .free

    /// Product ID backing the current entitlement, if any — used to show
    /// "Current plan" and to suppress the buy button on that card.
    @Published private(set) var activeProductID: String?

    /// True when Gold came from the one-time lifetime purchase. Suppresses
    /// all renewal copy, since nothing renews.
    @Published private(set) var hasLifetime = false

    /// Populated only if credits are re-enabled later. See SensaroCredits.
    @Published private(set) var creditsRemaining: Int?

    // ── Config ───────────────────────────────────────────────────────────
    // Apple IAP verification gateway (unchanged from the credit build).
    private let lambdaBase = "https://y25m8puewi.execute-api.us-west-1.amazonaws.com/prod"
    // accountControl gateway — /user-data lives here, not on lambdaBase.
    private let accountBase = "https://m4f0fvs9ye.execute-api.us-west-1.amazonaws.com/prod"
    private var transactionListenerTask: Task<Void, Never>?

    init() {
        transactionListenerTask = listenForTransactions()
        Task { await loadProducts() }
    }

    deinit { transactionListenerTask?.cancel() }


    // MARK: - Load Products

    func loadProducts() async {
        isLoadingProducts = true
        defer { isLoadingProducts = false }

        let ids = SensaroProduct.allCases.map(\.rawValue)
        print("🛒 [StoreKit] Requesting \(ids.count) products")

        do {
            let fetched = try await Product.products(for: ids)
            print("🛒 [StoreKit] Received \(fetched.count) product(s)")
            for p in fetched { print("   ✅ \(p.id) → \(p.displayPrice)") }

            for id in ids where !fetched.contains(where: { $0.id == id }) {
                print("   ⚠️ Missing from StoreKit response: \(id)")
            }

            let order = SensaroProduct.allCases.map(\.rawValue)
            self.products = fetched.sorted {
                (order.firstIndex(of: $0.id) ?? 99) < (order.firstIndex(of: $1.id) ?? 99)
            }
        } catch {
            print("❌ [StoreKit] loadProducts failed: \(error)")
            // Deliberately no `.failed` state here — the user hasn't tried to
            // buy anything yet. Cards fall back to `fallbackPrice` and the real
            // error surfaces on tap.
        }

        await refreshEntitlements()
    }


    // MARK: - Entitlement Resolution

    /// Walks every current entitlement Apple has signed for this Apple ID and
    /// keeps the highest tier found. Revoked (refunded) and expired
    /// transactions are skipped.
    func refreshEntitlements() async {
        var best: SensaroTier = .free
        var bestProductID: String?
        var lifetime = false

        for await result in Transaction.currentEntitlements {
            guard let transaction = try? checkVerified(result) else { continue }

            // Refunded / family-revoked — no longer entitles anything.
            if transaction.revocationDate != nil { continue }

            // Expired subscription that hasn't been cleaned up yet.
            if let expiry = transaction.expirationDate, expiry < Date() { continue }

            let tier: SensaroTier?
            if let product = SensaroProduct(rawValue: transaction.productID) {
                tier = product.tier
                if product.period == .lifetime { lifetime = true }
            } else {
                // Pre-migration purchase — grandfather rather than downgrade.
                tier = SensaroProduct.legacyGrandfathered[transaction.productID]
                if tier != nil {
                    print("ℹ️ [StoreKit] Grandfathering legacy product \(transaction.productID)")
                }
            }

            if let tier, tier > best {
                best = tier
                bestProductID = transaction.productID
            }
        }

        localTier = best
        activeProductID = bestProductID
        hasLifetime = lifetime
        recomputeEntitlement()
    }

    /// The user gets the better of what Apple proves locally and what the
    /// backend reports. A Stripe subscriber signing in on iPhone has no local
    /// entitlement; an Apple subscriber offline has no server response. Taking
    /// the max means neither is wrongly locked out.
    private func recomputeEntitlement() {
        entitledTier = max(localTier, serverTier)
    }

    // MARK: - Gating

    /// The one call every gate in the app should make.
    func can(_ feature: SensaroFeature) -> Bool {
        entitledTier >= feature.minimumTier
    }

    /// Tier the user would need in order to open `feature` — for upgrade copy.
    func requiredTier(for feature: SensaroFeature) -> SensaroTier {
        feature.minimumTier
    }


    // MARK: - Purchase

    func purchase(_ sensaroProduct: SensaroProduct, idToken: String) async {
        guard let product = products.first(where: { $0.id == sensaroProduct.rawValue }) else {
            let detail = products.isEmpty
                ? "No products loaded. Check App Store Connect configuration and the Paid Apps Agreement."
                : "Product '\(sensaroProduct.rawValue)' isn't available. Loaded: \(products.map(\.id).joined(separator: ", "))"
            print("❌ [StoreKit] Purchase guard failed — \(detail)")
            purchaseState = .failed(detail)
            return
        }
        await purchaseProduct(product, idToken: idToken)
    }

    private func purchaseProduct(_ product: Product, idToken: String) async {
        purchaseState = .purchasing
        do {
            // Attaching the account token lets the App Store Server Notification
            // reach the right Cognito user even if the app is killed before the
            // client-side sync below runs.
            var options: Set<Product.PurchaseOption> = []
            if let uuid = accountToken(from: idToken) {
                options.insert(.appAccountToken(uuid))
            }

            let result = try await product.purchase(options: options)

            switch result {
            case .success(let verification):
                let transaction = try checkVerified(verification)
                await refreshEntitlements()

                let tier = SensaroProduct(rawValue: transaction.productID)?.tier ?? entitledTier
                purchaseState = .success(productID: transaction.productID, tier: tier)

                // Finish first: the entitlement is already proven locally, so
                // the user is never blocked on a network round trip.
                await transaction.finish()

                // Then tell the backend, retrying in the background if needed.
                await syncTransactionToServer(
                    transaction: transaction,
                    jws: verification.jwsRepresentation,
                    idToken: idToken
                )

            case .userCancelled:
                purchaseState = .cancelled

            case .pending:
                // Ask-to-Buy or bank approval. The listener finishes the job.
                purchaseState = .pending

            @unknown default:
                purchaseState = .failed("Unrecognized purchase result. Please try again.")
            }
        } catch {
            purchaseState = .failed(error.localizedDescription)
        }
    }


    // MARK: - Restore

    func restorePurchases(idToken: String) async {
        purchaseState = .purchasing
        do {
            try await AppStore.sync()
            await refreshEntitlements()
            await syncServerTier(idToken: idToken)
            purchaseState = .idle
        } catch {
            purchaseState = .failed("Restore didn't complete: \(error.localizedDescription)")
        }
    }

    /// Opens Apple's own subscription management sheet. Required by App Review
    /// once you sell more than one subscription level.
    @available(iOS 15.0, *)
    func showManageSubscriptions(in scene: UIWindowScene) async {
        try? await AppStore.showManageSubscriptions(in: scene)
        await refreshEntitlements()
    }


    // MARK: - Transaction Listener

    /// Catches renewals, Ask-to-Buy approvals, refunds, and purchases made on
    /// another device. Without this, a renewal would not update the tier until
    /// the next cold start.
    private func listenForTransactions() -> Task<Void, Never> {
        Task(priority: .background) { [weak self] in
            for await result in Transaction.updates {
                guard let self else { break }
                guard let transaction = try? await self.checkVerified(result) else { continue }
                await transaction.finish()
                await self.refreshEntitlements()

                // Best-effort server sync using whatever token we have on hand.
                let token = await self.storedIdToken()
                if !token.isEmpty {
                    await self.syncTransactionToServer(
                        transaction: transaction,
                        jws: result.jwsRepresentation,
                        idToken: token
                    )
                }
            }
        }
    }


    // MARK: - Server Sync

    /// Reports a verified Apple transaction to the backend so it can write
    /// Cognito `custom:tier`. The signed JWS is included so the Lambda can
    /// re-verify with Apple's App Store Server API rather than trusting the
    /// client's word.
    private func syncTransactionToServer(transaction: Transaction, jws: String, idToken: String) async {
        guard !idToken.isEmpty else {
            // Not signed in yet (e.g. purchased before creating an account).
            // The local entitlement still works; queue the sync for later.
            queuePendingSync(transactionId: String(transaction.id), productId: transaction.productID)
            return
        }
        guard let url = URL(string: "\(lambdaBase)/apple-iap-verify") else { return }

        let payload: [String: Any] = [
            "transactionId":         String(transaction.id),
            "originalTransactionId": String(transaction.originalID),
            "productId":             transaction.productID,
            "tier":                  (SensaroProduct(rawValue: transaction.productID)?.tier ?? .free).rawValue,
            "signedTransaction":     jws,
            "platform":              "apple",
        ]

        do {
            var request = URLRequest(url: url)
            request.httpMethod = "POST"
            request.setValue("application/json", forHTTPHeaderField: "Content-Type")
            request.setValue("Bearer \(idToken)", forHTTPHeaderField: "Authorization")
            request.httpBody = try JSONSerialization.data(withJSONObject: payload)

            let (data, response) = try await URLSession.shared.data(for: request)

            guard let http = response as? HTTPURLResponse, http.statusCode == 200 else {
                queuePendingSync(transactionId: String(transaction.id), productId: transaction.productID)
                return
            }

            if let json = try? JSONSerialization.jsonObject(with: data) as? [String: Any] {
                serverTier = SensaroTier.parse(json["tier"], legacyPaid: json["paid"])
                if SensaroCredits.enabled { creditsRemaining = json["creditsRemaining"] as? Int }
                recomputeEntitlement()
            }
        } catch {
            queuePendingSync(transactionId: String(transaction.id), productId: transaction.productID)
        }
    }

    /// Pulls the authoritative tier from the account API. Call this on launch
    /// and after sign-in so Stripe-purchased tiers show up in the app.
    func syncServerTier(idToken: String) async {
        guard !idToken.isEmpty,
              let url = URL(string: "\(accountBase)/user-data") else { return }
        do {
            var request = URLRequest(url: url)
            request.setValue("Bearer \(idToken)", forHTTPHeaderField: "Authorization")
            let (data, response) = try await URLSession.shared.data(for: request)
            guard (response as? HTTPURLResponse)?.statusCode == 200,
                  let json = try? JSONSerialization.jsonObject(with: data) as? [String: Any]
            else { return }

            serverTier = SensaroTier.parse(json["custom:tier"], legacyPaid: json["custom:paid"])
            if SensaroCredits.enabled {
                creditsRemaining = Int("\(json["custom:predictionsRemaining"] ?? "")")
            }
            recomputeEntitlement()
        } catch {
            print("⚠️ [StoreKit] syncServerTier failed: \(error.localizedDescription)")
        }
    }


    // MARK: - Pending Sync Queue

    private func queuePendingSync(transactionId: String, productId: String) {
        var pending = UserDefaults.standard.stringArray(forKey: "pending_tier_syncs") ?? []
        let entry = "\(transactionId):\(productId)"
        guard !pending.contains(entry) else { return }
        pending.append(entry)
        UserDefaults.standard.set(pending, forKey: "pending_tier_syncs")
        print("⚠️ [StoreKit] Queued \(transactionId) for server sync")
    }

    /// Call on launch once an ID token is available.
    func retryPendingSyncs(idToken: String) async {
        guard !idToken.isEmpty else { return }
        let pending = UserDefaults.standard.stringArray(forKey: "pending_tier_syncs") ?? []
        guard !pending.isEmpty else { return }

        var remaining: [String] = []
        for entry in pending {
            let parts = entry.split(separator: ":", maxSplits: 1).map(String.init)
            guard parts.count == 2 else { continue }
            let ok = await retrySync(transactionId: parts[0], productId: parts[1], idToken: idToken)
            if !ok { remaining.append(entry) }
        }
        UserDefaults.standard.set(remaining, forKey: "pending_tier_syncs")
        await syncServerTier(idToken: idToken)
    }

    private func retrySync(transactionId: String, productId: String, idToken: String) async -> Bool {
        guard let url = URL(string: "\(lambdaBase)/apple-iap-verify") else { return false }
        let payload: [String: Any] = [
            "transactionId": transactionId,
            "productId":     productId,
            "tier":          (SensaroProduct(rawValue: productId)?.tier ?? .free).rawValue,
            "platform":      "apple",
        ]
        do {
            var request = URLRequest(url: url)
            request.httpMethod = "POST"
            request.setValue("application/json", forHTTPHeaderField: "Content-Type")
            request.setValue("Bearer \(idToken)", forHTTPHeaderField: "Authorization")
            request.httpBody = try JSONSerialization.data(withJSONObject: payload)
            let (_, response) = try await URLSession.shared.data(for: request)
            let ok = (response as? HTTPURLResponse)?.statusCode == 200
            if ok { print("✅ [StoreKit] Synced \(transactionId)") }
            return ok
        } catch {
            return false   // stays queued, retried next launch
        }
    }


    // MARK: - Helpers

    private func checkVerified<T>(_ result: VerificationResult<T>) throws -> T {
        switch result {
        case .unverified(_, let error): throw error
        case .verified(let safe):       return safe
        }
    }

    private func storedIdToken() -> String {
        UserDefaults.standard.string(forKey: "id_token") ?? ""
    }

    /// Derives a stable UUID from the Cognito `sub` claim so App Store Server
    /// Notifications can be attributed to a user server-side.
    private func accountToken(from idToken: String) -> UUID? {
        let parts = idToken.split(separator: ".")
        guard parts.count > 1 else { return nil }
        var b64 = String(parts[1]).replacingOccurrences(of: "-", with: "+")
                                   .replacingOccurrences(of: "_", with: "/")
        while b64.count % 4 != 0 { b64 += "=" }
        guard let data = Data(base64Encoded: b64),
              let json = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
              let sub = json["sub"] as? String
        else { return nil }
        return UUID(uuidString: sub)
    }

    func product(for sensaroProduct: SensaroProduct) -> Product? {
        products.first { $0.id == sensaroProduct.rawValue }
    }

    func formattedPrice(for sensaroProduct: SensaroProduct) -> String {
        product(for: sensaroProduct)?.displayPrice ?? sensaroProduct.fallbackPrice
    }

    /// "$49.99/yr works out to $4.16/mo" — computed from the real localized
    /// price so it stays correct in every storefront.
    func monthlyEquivalent(for sensaroProduct: SensaroProduct) -> String? {
        guard sensaroProduct.period == .yearly,
              let product = product(for: sensaroProduct) else { return nil }
        let perMonth = product.price / 12
        return product.priceFormatStyle.format(perMonth)
    }

    func isCurrentPlan(_ sensaroProduct: SensaroProduct) -> Bool {
        activeProductID == sensaroProduct.rawValue
    }
}
